{
  "name": "VC JOIN LEAVE TRACKER",
  "description": "Telegram Voice Chat JOIN / LEAVE Tracker",
  "repository": "https://github.com/babaji067/VC-JOIN-LEAVE",
  "keywords": [
    "telegram",
    "voice-chat",
    "tracker",
    "pyrogram",
    "mongodb"
  ],
  "env": {
    "API_ID": {
      "description": "Telegram API ID",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API HASH",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Telegram Bot Token",
      "required": true
    },
    "SESSION_STRING": {
      "description": "Pyrogram User Session String",
      "required": true
    },
    "MONGO_URL": {
      "description": "MongoDB connection URL",
      "required": true
    },
    "LOG_CHANNEL": {
      "description": "Telegram Log Channel ID",
      "required": true
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  }
}